PORT=9000

# Number of reverse proxies (load balancer, Nginx, Render, etc.) in front of the
# server, so rate limits see the real client IP. Leave at 0 when the server is
# reached directly; setting it too high lets clients spoof their IP.
TRUST_PROXY=0
# Set to false to turn off all API rate limiting (the test suite does this).
RATE_LIMIT_ENABLED=true
# Optional: Redis for rate-limit counters and refresh-token revocation, shared
# across instances and kept across restarts. Leave blank to use in-memory stores.
# If set but unreachable, the server still starts on in-memory stores and
# switches to Redis when it connects. See REDIS.md.
REDIS_URL=

# PDF imports: concurrent imports per process, and imports started per minute
# across all workers (the per-minute cap needs Redis). Set IMPORT_WORKER_IN_API=false
# to run the worker as its own process with `npm run worker`.
IMPORT_WORKER_CONCURRENCY=2
IMPORT_JOBS_PER_MINUTE=10
IMPORT_WORKER_IN_API=true

MONGODB_URI=mongodb://localhost:27017/tdb

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# Cloudinary - profile picture storage. Find all three on your Cloudinary
# dashboard at https://console.cloudinary.com. The cloud name is required:
# without it the avatar endpoints return 503 and the rest of the app is
# unaffected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth - create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/google/callback

# Gemini API keys - get them at https://aistudio.google.com/apikey
# Any number of GEMINI_KEY<n> entries are used in rotation: when one key is
# rate limited or rejected, the next one is tried, and the last key that worked
# is used first on the next request. Blank entries are ignored.
GEMINI_KEY1=
GEMINI_KEY2=
GEMINI_KEY3=
GEMINI_KEY4=
# Optional: comma-separated models, tried in order. An overloaded model (503)
# falls through to the next one on the same key. Defaults to
# gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS=

# Resend - get your API key at https://resend.com/api-keys
RESEND_API_KEY=
# Default uses Resend sandbox. For production, use a verified domain address.
EMAIL_FROM=onboarding@resend.dev

# Frontend URL - used for CORS and email links
FRONTEND_URL=http://localhost:3000
