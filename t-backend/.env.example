PORT=9000

MONGODB_URI=mongodb://localhost:27017/tdb

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# Cloudinary - profile picture storage. Find all three on your Cloudinary
# dashboard at https://console.cloudinary.com. The cloud name is required:
# without it the avatar endpoints return 503 and the rest of the app is
# unaffected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth - create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/google/callback

# Gemini API keys - get them at https://aistudio.google.com/apikey
# Any number of GEMINI_KEY<n> entries are used in rotation: when one key is
# rate limited or rejected, the next one is tried, and the last key that worked
# is used first on the next request. Blank entries are ignored.
GEMINI_KEY1=
GEMINI_KEY2=
GEMINI_KEY3=
GEMINI_KEY4=
# Optional: comma-separated models, tried in order. Defaults to
# gemini-3.7-flash,gemini-3.5-flash
GEMINI_MODELS=

# Resend - get your API key at https://resend.com/api-keys
RESEND_API_KEY=
# Default uses Resend sandbox. For production, use a verified domain address.
EMAIL_FROM=onboarding@resend.dev

# Frontend URL - used for CORS and email links
FRONTEND_URL=http://localhost:3000
